		}
		{
			dependencies: ["019D858D15FE3AC6"]
			description: ["소형 물류 열차는 바닐라 철로에서 작동하지만, 광산 수레 대신 맞춤형 열차 차량 엔티티를 사용합니다."]
			icon: "littlelogistics:steam_locomotive"
			id: "595BD3E85F2C6557"
